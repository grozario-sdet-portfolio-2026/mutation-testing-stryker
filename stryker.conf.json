{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "reporters": ["html", "json", "progress"],
  "coverageAnalysis": "off",
  "mutate": ["src/**/*.ts", "!src/**/*.d.ts", "!src/index.ts"],
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "maxTestRunnerReuse": 1,
  "typeScriptChecker": {
    "enabled": false
  },
  "thresholds": {
    "high": 0,
    "low": 0,
    "break": 0
  },
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  }
}
